# ==============================================================================
# Multi-Stage Dockerfile: Standalone Executable for IADCS Web App
# Stage 1: Build standalone single-file binary using PyInstaller
# Stage 2: Minimal Runtime (Executes compiled binary with ZERO Python runtime)
# ==============================================================================

# --- STAGE 1: Compilation ---
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Install PyInstaller and required Python backend packages
RUN pip install --no-cache-dir pyinstaller==6.12.0 PyYAML==6.0.2 rich==14.0.0 Send2Trash>=1.8.3

# Copy application source tree
COPY . .

# Build the standalone binary via PyInstaller spec
RUN pyinstaller --clean --noconfirm iadcs_web.spec

# Verify that the executable was created and is executable
RUN ls -la dist/ && chmod +x dist/iadcs-web.exe

# --- STAGE 2: Minimal Container Runtime ---
FROM debian:bookworm-slim AS runtime

WORKDIR /app

# Ensure basic CA certificates for any outbound checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy ONLY the standalone executable from the builder image
COPY --from=builder /build/dist/iadcs-web.exe /app/iadcs-web.exe

# Ensure execution permission
RUN chmod +x /app/iadcs-web.exe

# Expose Web Dashboard Port
EXPOSE 8080

# Run the standalone executable directly
ENTRYPOINT ["/app/iadcs-web.exe"]
CMD ["8080"]
